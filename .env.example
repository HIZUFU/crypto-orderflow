APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-value

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/orderflow.db

# Exchange settings
DEFAULT_EXCHANGE=bybit
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BINANCE_WS_URL=wss://fstream.binance.com/ws

# Market data
SYMBOLS=BTCUSDT,ETHUSDT
ORDERBOOK_DEPTH=50
RECONNECT_DELAY_SECONDS=5

# Signal generation
SIGNAL_COOLDOWN_SECONDS=15
SIGNAL_TTL_SECONDS=120

# Trading
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
PAPER_NOTIONAL_USDT=50
PAPER_LEVERAGE=1
PAPER_FEE_RATE=0.00055

# Position monitoring
POSITION_MONITOR_INTERVAL_SECONDS=1.0
ENABLE_AUTO_CLOSE=true

# ML filter (future)
USE_ML_FILTER=false
ML_MODEL_PATH=data/models/signal_filter.cbm
ML_THRESHOLD=0.5
