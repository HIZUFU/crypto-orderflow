DEFAULT_EXCHANGE=bybit
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BINANCE_WS_URL=wss://fstream.binance.com/stream
SYMBOLS=BTCUSDT,ETHUSDT
ORDERBOOK_DEPTH=50
RECONNECT_DELAY_SECONDS=5

SIGNAL_COOLDOWN_SECONDS=15
SIGNAL_TTL_SECONDS=120

TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
PAPER_NOTIONAL_USDT=50
PAPER_LEVERAGE=1
PAPER_FEE_RATE=0.00055
INITIAL_PAPER_BALANCE=10000
RISK_MODE=percent_notional
RISK_VALUE=0.0015
REWARD_RISK_RATIO=2.0

POSITION_MONITOR_INTERVAL_SECONDS=1.0
OUTCOME_MONITOR_INTERVAL_SECONDS=5.0
ENABLE_AUTO_CLOSE=true

USE_ML_FILTER=false
ML_MODEL_PATH=data/models/signal_filter.cbm
ML_THRESHOLD=0.55
